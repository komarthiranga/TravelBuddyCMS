# Copy this file to .env.local and paste your real values.
# Never commit .env.local.

DATABASE_URL=

# Optional. With this set, "Take me there" uses Google roads and Google tiles.
# Without it, OpenStreetMap + OSRM still give a live in-app ride.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_API_KEY=

# Server-only key for public online discovery (Places API New).
# Never use NEXT_PUBLIC_ for these credentials.
GOOGLE_PLACES_API_KEY=
# Optional, used only by the read-only provider comparison script.
FOURSQUARE_API_KEY=

# Google sign-in (Web application OAuth client).
# Local redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate a unique random secret for each environment; never commit real values.
AUTH_SECRET=
# Set AUTH_URL to your canonical HTTPS origin in production.
# AUTH_URL=https://your-domain.example

# Development backstop: provider requests per UTC day, per server process.
# Includes city autocomplete, city details, searches, place details and photos.
# 0 disables provider calls. This is NOT a Google Cloud billing cap.
PLACES_DAILY_CALL_LIMIT=100
